<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.aschemann.otel</groupId>
    <artifactId>osgi-otel-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OSGi OpenTelemetry Extension - Parent</name>
    <description>
        Extension for the OpenTelemetry Java Agent that adds instrumentation
        for OSGi inter-bundle data flow (ServiceRegistry, EventAdmin, DS,
        Equinox-specific APIs).
    </description>
    <url>https://github.com/ascheman/osgi-otel</url>

    <scm>
        <connection>scm:git:git@github.com:ascheman/osgi-otel.git</connection>
        <developerConnection>scm:git:git@github.com:ascheman/osgi-otel.git</developerConnection>
        <url>https://github.com/ascheman/osgi-otel</url>
        <tag>HEAD</tag>
    </scm>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Gerd Aschemann</name>
            <email>gerd@aschemann.net</email>
        </developer>
    </developers>

    <modules>
        <module>osgi-otel-extension</module>
        <module>osgi-otel-file-exporter</module>
        <module>osgi-otel-test-bundle</module>
        <module>osgi-otel-it</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
          release, not source/target: source/target only sets the language level
          and still compiles against the JDK that happens to run the build, so a
          post-8 API call compiles cleanly here and fails with NoSuchMethodError
          on the Java 8 hosts this extension targets. release pins the API
          surface as well, and drops javac's "bootstrap class path is not set"
          warning, which was the symptom of exactly that gap.
        -->
        <maven.compiler.release>8</maven.compiler.release>

        <otel.javaagent.version>2.32.0</otel.javaagent.version>
        <otel.instrumentation.version>2.32.0</otel.instrumentation.version>
        <!-- ACCEPTED pre-release exception: OpenTelemetry publishes its javaagent
             extension-API, tooling and testing artifacts only with an -alpha suffix
             (their API is not declared stable); there is no stable-named variant and
             the extension cannot be built without them. These are provided/test only
             and must stay in lockstep with otel.instrumentation.version; the shipped
             agent (otel.javaagent.version) is GA. -->
        <otel.instrumentation.alpha.version>2.32.0-alpha</otel.instrumentation.alpha.version>
        <otel.sdk.bom.version>1.67.0</otel.sdk.bom.version>

        <osgi.core.version>6.0.0</osgi.core.version>

        <!-- Compile-only (provided): only stable API is used and the host supplies
             its own version at runtime. Kept at Java-11 bytecode so the extension
             builds on any JDK >= 11, matching the Java-8 runtime target. -->
        <eclipse.commands.version>3.13.0</eclipse.commands.version>
        <eclipse.jface.version>3.26.0</eclipse.jface.version>
        <emf.common.version>2.26.0</emf.common.version>

        <!-- Must match the byte-buddy that the OTel agent bundles at runtime
             (byte-buddy is provided): opentelemetry-javaagent 2.32.0 ships
             byte-buddy-dep 1.18.14. Do not bump independently of the agent. -->
        <bytebuddy.version>1.18.14</bytebuddy.version>
        <autoservice.version>1.1.1</autoservice.version>

        <junit.version>5.14.4</junit.version>
        <assertj.version>3.27.7</assertj.version>

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.6.1</maven.surefire.plugin.version>
        <maven.failsafe.plugin.version>3.6.1</maven.failsafe.plugin.version>
        <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
        <maven.dependency.plugin.version>3.11.0</maven.dependency.plugin.version>
        <maven.bundle.plugin.version>5.1.9</maven.bundle.plugin.version>
        <maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
        <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
        <!-- Lifecycle plugins that are never declared explicitly. Pinned because
             their newest releases are Maven-4 betas: left unpinned, Maven 3.9
             resolves the latest RELEASE, rejects each 4.0.0-beta-* for unmet
             prerequisites with a WARNING, and only then falls back to a 3.x. -->
        <maven.resources.plugin.version>3.5.0</maven.resources.plugin.version>
        <maven.install.plugin.version>3.2.0</maven.install.plugin.version>
        <maven.deploy.plugin.version>3.2.0</maven.deploy.plugin.version>

        <github.repo>osgi-otel</github.repo>

        <!-- Release-only plugins, used by the `release` profile. -->
        <maven.source.plugin.version>3.4.0</maven.source.plugin.version>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
        <maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
        <jreleaser.maven.plugin.version>1.26.0</jreleaser.maven.plugin.version>
        <!-- Trailing '!' pins this exact key; without it GnuPG may pick another
             key from the keyring. Override with -Dgpg.keyname=... to release
             from a different one. -->
        <gpg.keyname>D6D79905C2FDD3E4FA6C13A9F3182FD01BA43E49!</gpg.keyname>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${otel.sdk.bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.opentelemetry.javaagent</groupId>
                <artifactId>opentelemetry-javaagent-extension-api</artifactId>
                <version>${otel.instrumentation.alpha.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.javaagent</groupId>
                <artifactId>opentelemetry-javaagent-tooling</artifactId>
                <version>${otel.instrumentation.alpha.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-api</artifactId>
                <version>${otel.instrumentation.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.javaagent</groupId>
                <artifactId>opentelemetry-javaagent</artifactId>
                <version>${otel.javaagent.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.javaagent</groupId>
                <artifactId>opentelemetry-agent-for-testing</artifactId>
                <version>${otel.instrumentation.alpha.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.javaagent</groupId>
                <artifactId>opentelemetry-testing-common</artifactId>
                <version>${otel.instrumentation.alpha.version}</version>
            </dependency>

            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${bytebuddy.version}</version>
            </dependency>

            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service-annotations</artifactId>
                <version>${autoservice.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service</artifactId>
                <version>${autoservice.version}</version>
            </dependency>

            <dependency>
                <groupId>org.osgi</groupId>
                <artifactId>org.osgi.core</artifactId>
                <version>${osgi.core.version}</version>
            </dependency>

            <!-- Eclipse UI instrumentation (compile-only; the host supplies these at runtime).
                 SWT is excluded: it is a platform-specific transitive of JFace and the
                 advice never references SWT types. -->
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.core.commands</artifactId>
                <version>${eclipse.commands.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.jface</artifactId>
                <version>${eclipse.jface.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.eclipse.platform</groupId>
                        <artifactId>org.eclipse.swt</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.eclipse.emf</groupId>
                <artifactId>org.eclipse.emf.common</artifactId>
                <version>${emf.common.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      Snapshots from a local working copy go to the Central Portal, the same
      place the release lands. CI overrides this in the `github-ci` profile.
    -->
    <distributionManagement>
        <snapshotRepository>
            <id>central-snapshots</id>
            <name>Central Portal Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <profile>
            <!--
              CI publishes SNAPSHOTs to GitHub Packages in addition to the
              Central Portal snapshots deployed from a local working copy.
              Activated by GITHUB_ACTIONS, which GitHub Actions sets and a local
              shell does not - unlike GITHUB_TOKEN, which the local direnv setup
              also exports and which would therefore hijack local deploys.
              A profile's distributionManagement overrides the project-level one
              for the same element, so this wins inside Actions only.
            -->
            <id>github-ci</id>
            <activation>
                <property>
                    <name>env.GITHUB_ACTIONS</name>
                </property>
            </activation>
            <distributionManagement>
                <snapshotRepository>
                    <id>github</id>
                    <name>GitHub Packages</name>
                    <!--
                      One package repository per GitHub repository, not per
                      module: ${project.artifactId} would send every module to a
                      URL of its own, and only osgi-otel exists.
                    -->
                    <url>https://maven.pkg.github.com/ascheman/${github.repo}</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>

        <profile>
            <!--
              Release from a local working copy, so that signing uses the local
              GnuPG agent and the private key never leaves this machine:

                  ./mvnw -Prelease clean deploy
                  ./mvnw -Prelease jreleaser:full-release

              The first command builds, signs and stages everything into
              ${staging.repository.directory}; the second uploads that staging
              repository to Maven Central and creates the GitHub release.

              Credentials come from the environment, never from the repository:
              JRELEASER_GITHUB_TOKEN plus JRELEASER_MAVENCENTRAL_USERNAME and
              JRELEASER_MAVENCENTRAL_PASSWORD (the Central Portal user token, not
              the account password). JReleaser itself is configured in jreleaser.yml.
            -->
            <id>release</id>
            <properties>
                <!--
                  The reactor root, NOT ${project.build.directory}: that resolves
                  per module, so every module would stage into its own
                  <module>/target/staging-deploy and JReleaser - which reads the
                  single directory named in jreleaser.yml - would upload the
                  parent POM alone and report success.
                -->
                <staging.repository.directory>${maven.multiModuleProjectDirectory}/target/staging-deploy</staging.repository.directory>
            </properties>
            <distributionManagement>
                <!--
                  Deploy to a local directory rather than to a remote repository.
                  JReleaser picks the artifacts up from here, which keeps the upload
                  a separate, repeatable step: a failed upload does not require a rebuild.
                -->
                <repository>
                    <id>staging</id>
                    <url>file://${staging.repository.directory}</url>
                </repository>
                <!--
                  Also the snapshot element: a profile's distributionManagement
                  is merged with the one outside it element by element, so
                  without this a -Prelease deploy on a still-SNAPSHOT version
                  would fall through to the snapshot repository and leave the
                  staging directory empty.
                -->
                <snapshotRepository>
                    <id>staging</id>
                    <url>file://${staging.repository.directory}</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.source.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven.javadoc.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <keyname>${gpg.keyname}</keyname>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jreleaser</groupId>
                        <artifactId>jreleaser-maven-plugin</artifactId>
                        <version>${jreleaser.maven.plugin.version}</version>
                        <inherited>false</inherited>
                        <configuration>
                            <!--
                              Required. The Maven plugin does NOT pick up
                              jreleaser.yml by itself: without configFile it
                              builds its model from this POM instead
                              (AbstractJReleaserMojo: `null == configFile ?
                              convertModel() : readModel(logger)`), silently
                              ignoring the file. The symptom is not an error
                              but "[maven] Deploying is not enabled. Skipping",
                              because the whole deploy section is then absent
                              from the model. Check the log for
                              "Configuring with .../jreleaser.yml".
                            -->
                            <configFile>${project.basedir}/jreleaser.yml</configFile>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven.dependency.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.felix</groupId>
                    <artifactId>maven-bundle-plugin</artifactId>
                    <version>${maven.bundle.plugin.version}</version>
                    <extensions>true</extensions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven.enforcer.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.install.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Build must run on Maven 3.9.x: Maven 4 binds incompatible beta
                 core plugins (e.g. maven-install-plugin:4.0.0-beta-3). Use ./mvnw. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-maven-version</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,4.0)</version>
                                    <message>Build with Maven 3.9.x via ./mvnw; Maven 4 is not supported (incompatible beta core plugins).</message>
                                </requireMavenVersion>
                                <!-- NOTE: a general alpha/beta ban is deliberately NOT enforced here.
                                     bannedDependencies treats any wildcard version pattern as match-all,
                                     so an "-alpha suffix" ban cannot be expressed without banning every
                                     dependency. The only pre-release deps we use are OpenTelemetry's
                                     javaagent extension-API/tooling/testing artifacts, which OTel
                                     publishes only with an -alpha suffix (API not declared stable);
                                     they are provided/test only and the shipped agent is GA. This is
                                     the documented, accepted exception (see the otel.*.alpha property). -->
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
